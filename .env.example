APP_NAME="Forefront Solutions (K) Ltd"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/fslc/public
# Laragon: keep APP_URL in sync with your virtual host path (include /public if not using vhost rewrite).
# Production: https://forefrontsolutions.co.ke (no /public segment).

# Token for /clear-cache?token=... (shared hosting; no auth required)
CLEAR_CACHE_TOKEN=change-me-to-random-string

# OAuth / Socialite — set true only when Google/Facebook/Apple login is configured and needed
SOCIAL_LOGIN_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: set LOG_LEVEL=error

# Required on cPanel / Cloudflare so Laravel detects HTTPS (secure cookies, canonical URLs).
# Leave blank for local dev. In production set to "*" (see .env.production / DEPLOYMENT.md) —
# without it, login redirect-loops behind a reverse proxy.
TRUSTED_PROXIES=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use database + cron schedule:run for queued mail; or sync for immediate send without worker
QUEUE_CONNECTION=database

CACHE_STORE=database
# For faster full-page HTML cache on shared hosting, consider CACHE_STORE=file
# Keep database cache on shared hosting (Redis optional at scale — do not switch unless infra supports it)

# Optional CDN for static assets (heroes, OG images)
# CDN_URL=https://cdn.forefrontsolutions.co.ke
# ASSET_URL=

# Google Analytics 4 measurement ID (also editable in Admin → Settings)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Preloader (disabled by default for Core Web Vitals)
FOREFRONT_SHOW_PRELOADER=false

# Page cache (shared hosting: database cache works fine)
PUBLIC_PAGE_CACHE_TTL=300
PUBLIC_PAGE_CACHE_MAX_BYTES=1048576
# Browser Cache-Control max-age for anonymous HTML when page cache hits (0 = omit header)
PUBLIC_PAGE_CACHE_BROWSER_MAX_AGE=120

# Upload limits (KB)
UPLOAD_DOCUMENT_MAX_KB=5120
UPLOAD_IMAGE_MAX_KB=2048

# App cache version (optional; bump to invalidate ContentService-style caches)
# APP_CACHE_VERSION=v1

# Lead generation
# Spam score threshold (0–100). Leads at or above this are marked spam. Default: 45
LEAD_SPAM_THRESHOLD=45
# Max contact/lead submissions per minute per IP (shared between /contact and /leads)
LEAD_SUBMISSIONS_PER_MINUTE=10

# Security headers
SECURITY_CSP_ENFORCE=false
# After `php artisan csp:status` shows zero violations, set true on production:
# SECURITY_CSP_ENFORCE=true
SECURITY_CSP_REPORT_ENABLED=true
# Optional extra directives, e.g. "frame-src 'self' https://www.youtube.com"
SECURITY_CSP_EXTRA_DIRECTIVES=

# Sitemap — ping Bing after regen in production (Google ping deprecated; use Search Console)
SITEMAP_PING_SEARCH_ENGINES=false
SITEMAP_PING_GOOGLE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Zoho Mail (production): smtp.zoho.com:587 + TLS
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=support@forefrontsolutions.co.ke
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@forefrontsolutions.co.ke"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=30
MAIL_EHLO_DOMAIN=forefrontsolutions.co.ke

# Shared-hosting secure cookie defaults (set true on HTTPS production)
SESSION_SECURE_COOKIE=false

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
