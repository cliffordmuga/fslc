<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Local dev (Laragon subdirectory install, e.g. http://localhost/fslc/public).
    # -------------------------------------------------------------------------
    # SHARED HOSTING: change this to "RewriteBase /" before uploading.
    # public_html/ serves from the domain root there, not a /fslc/public
    # subdirectory — leaving this as-is makes every non-homepage URL 404 at
    # the Apache level (front controller rewrite resolves to a filesystem
    # path that doesn't exist), even though "/" itself loads fine via
    # DirectoryIndex.
    # -------------------------------------------------------------------------
    RewriteBase /fslc/public

    # -------------------------------------------------------------------------
    # SHARED HOSTING: path to the Laravel project root (outside public_html/).
    # Uncomment and set to your actual cPanel path before uploading.
    # -------------------------------------------------------------------------
    # SetEnv APP_LARAVEL_PATH /home/YOUR_CPANEL_USER/fslc

    # Force www → non-www redirect (canonical domain is non-www; matches APP_URL / DEPLOYMENT.md)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Force HTTPS — uncomment after SSL certificate is active.
    # Optional belt-and-suspenders: Laravel's ForceHttps middleware already
    # redirects http -> https automatically whenever APP_ENV=production,
    # so this is not required for correctness, just for redirecting before PHP boots.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Static asset caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 month"
    ExpiresByType image/avif                "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/x-icon              "access plus 1 month"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^sitemap\.xml$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # Strip the PHP version fingerprint (set by PHP's expose_php ini, not
    # Laravel) on every response. The Apache "Server" header can't be
    # suppressed from .htaccess — Header unset doesn't reach it — that needs
    # ServerTokens Prod in the host's main config, which shared hosting rarely
    # exposes; ask the host to set it if the version string is a concern.
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# Gzip compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Security: block access to hidden files (.env, .git, etc.)
# ---------------------------------------------------------------------------
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
